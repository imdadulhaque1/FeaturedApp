{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@features/*": ["src/features/*"],
      "@nativeModules/*": ["src/nativeModules/*"],
      "@navigations/*": ["src/navigations/*"],
      "@shared/*": ["src/shared/*"],
      "@stateManagement/*": ["src/stateManagement/*"],
      "@src/*": ["src/*"]
    }
  }
}
